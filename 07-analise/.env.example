OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modelos congelados para o experimento
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.1-pro-preview

# Limite uniforme de saída
MAX_OUTPUT_TOKENS=8192
